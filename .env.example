# Copie ce fichier en .env puis remplace les valeurs.
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=colle_ici_le_secret_client

# D7, D30, D90 ou D180. D180 est conseillé pour l'analyse d'inactivité.
GRAPH_PERIOD=D180

# Cache local des rapports Graph Reports, en heures.
REPORT_CACHE_HOURS=12

# Optionnel : si tu veux désactiver les rapports d'activité M365.
ENABLE_REPORTS=true

# -------------------------------
# Exchange Online live API (V4)
# -------------------------------
# false = aucune requete Exchange Online. true = l'application interroge Exchange Online en live via le module ExchangeOnlineManagement.
ENABLE_EXCHANGE_ONLINE=false

# app_certificate = recommande pour eviter une connexion interactive a chaque appel.
# interactive = mode local de test avec Connect-ExchangeOnline -UserPrincipalName.
EXCHANGE_AUTH_MODE=app_certificate

# Domaine primaire .onmicrosoft.com du tenant, ex : contoso.onmicrosoft.com
EXCHANGE_ORGANIZATION=contoso.onmicrosoft.com

# Mode app_certificate : App registration qui a le role Exchange Administrator + certificat installe sur le poste.
EXCHANGE_APP_ID=00000000-0000-0000-0000-000000000000
EXCHANGE_CERTIFICATE_THUMBPRINT=COLLE_ICI_LE_THUMBPRINT_DU_CERTIFICAT

# Mode interactive uniquement.
EXCHANGE_ADMIN_UPN=admin@contoso.com

# Lire les delegations FullAccess / SendAs / SendOnBehalf.
EXCHANGE_INCLUDE_PERMISSIONS=true

# Cache local court des resultats Exchange live pour eviter de reconnecter trop souvent pendant les tests.
EXCHANGE_CACHE_MINUTES=30
EXCHANGE_TIMEOUT_SECONDS=120

# Optionnel : chemin explicite vers PowerShell si necessaire.
# EXCHANGE_POWERSHELL_PATH=C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe

